# Copy to .env and fill in real values. .env is gitignored; this file is the checked-in template.
# Same KEY=VALUE format works two ways: `EnvironmentFile=` in a systemd service (deployment),
# or sourced into your shell for local runs (see backend/README or ask for the exact command).

Storage__Provider=R2
Storage__R2AccountId=
Storage__R2AccessKeyId=
Storage__R2SecretAccessKey=
Storage__R2BucketName=lychee
